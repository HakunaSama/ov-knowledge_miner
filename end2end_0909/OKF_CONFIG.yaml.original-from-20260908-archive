version: "1.0"

# OKF contract for the SF Express enterprise knowledge base.
# Main view: four Page Roles (topic/reference/procedure/synthesis, mapping to
# TOPIC/REFERENCE/PROCEDURE/SYNTHESIS) x fourteen Level-2 business domains
# each Level 2 has predefined Level 3 core sub-domains and
# Level 4+ dynamic clustering. One Knowledge Object = one canonical page.
# Projection views: four core perspectives reusing the same pages via
# namespaced frontmatter tags (soft-link projections).

frontmatter:
  required:
    - type
    - title
    - description
    - tags
    - status
    - sources
    - generated
    - knowledge_links
  allowed_types:
    - entity
    - concept
    - method
    - comparison
    - analysis
    - index
  page_role_directory:
    topic: "TOPIC(主题知识:解释对象、概念、产品、机制是什么)"
    reference: "REFERENCE(精确参考:规则、参数、口径、FAQ、术语)"
    procedure: "PROCEDURE(操作方法:SOP、流程、排障、审批、实施步骤)"
    synthesis: "SYNTHESIS(综合分析:对比、分析、决策、复盘、综合研究)"
  knowledge_type_directory:
    products: 产品与解决方案
    marketing: 市场与营销
    sales: 销售与商业拓展
    customer-development: 客户经营
    customer-service: 客户服务
    network-planning: 网络规划与调度
    operations: 运营与履约
    quality-safety: 质量与安全
    business-management: 经营与管理
    enterprise-services: 企业综合服务
    human-resource: 人力与组织
    finance: 财务、资金与信用
    technology: 技术、数据与智能化
    compliance: 制度、法务与风险治理
  defaults:
    status: stable
  sources:
    required_fields:
      - resource
      - title
      - author
    require_input: true
    # evidence-ledger is a platform-owned, KB-level artifact at the fixed path
    # _mining/evidence-ledger.json. Its own pages[] array carries the
    # page->intermediate mapping (including the ledger URI as an
    # intermediate_resources entry), so the ledger URI is NOT duplicated in
    # per-page sources. sources stays pure original input.
    require_intermediate: false
  generated:
    required_fields:
      - by
      - at
    by_template: "{skill}/{model}"

# Physical main view:
#   knowledge/<page_role>/<L2-business-domain>/<L3-core-subdomain>/<filename>.md
# Level 1 = page role (fixed, 4). Level 2 = business domain (fixed, 14).
# Level 3 = predefined core sub-domain (stable, see business_domains).
# Level 4+ = dynamic clustering by product/object/scene/rule/process/topic;
#   fixed nodes are not force-created empty; directories materialize as needed.
# One Knowledge Object = one canonical page; the directory path is NOT the
# knowledge identity (the promoted candidate's `id`, not the directory path).
main_view:
  single_source_of_truth: true
  root_path: knowledge
  level_structure:
    level_1: page_role          # fixed, 4 (page_roles)
    level_2: business_domain    # fixed, 14 (role_domains)
    level_3: core_subdomain     # predefined, stable (business_domains)
    level_4_plus: dynamic       # by product/object/scene/rule/process/topic
