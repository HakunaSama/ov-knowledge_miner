    type: index
  exempt_paths:
    - "**/index.md"
  derived_views_include_exempt: false

# Viewable mining artifacts are committed beside the canonical pages. The evidence
# ledger connects every page to both its input evidence and this intermediate chain.
intermediates:
  required: true
  root_path: _mining
  run_manifest: run-manifest.json
  evidence_ledger: evidence-ledger.json
  investigation_report: investigation-report.json
  questionnaire: questionnaire.json
  source_coverage: source-coverage.json
  candidate_knowledge: candidate-knowledge.json
  readlist: readlist.json
  evidence_history: evidence-history.json

# Cross-knowledge-base references are explicit OpenViking URIs. A bidirectional
# relation must be mirrored in the counterpart checkout when that checkout is writable.
cross_knowledge:
  frontmatter_field: knowledge_links
  context_field: context
  require_body_link: true
  allowed_relations:
    - related
    - depends-on
    - derived-from
    - supersedes

# Projection views (four core perspectives). The main view always follows the
# physical path tree above; these views reorganize the same pages by namespaced
# OKF frontmatter tags - the OpenViking equivalent of logical soft-links
# (ViewPlacement): one page, many projections, zero page copies.
# A view tag is the page's COMPLETE projection directory in that view:
#   view/<view-title>/<一级目录>/<二级目录>   e.g. view/业务线/速运BG/M线知识
# Directory names are copied verbatim from the trees below. customers-projects
# inserts the concrete customer/project name as a dynamic directory between the
